# 大模型 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 阿里云百炼 DashScope API Key（Embedding + Rerank）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX_TICKETS=tickets
ES_INDEX_KNOWLEDGE=knowledge_base
ES_INDEX_FAQ=faq

# Kafka
KAFKA_BOOTSTRAP=localhost:9092
# 部门 Topic（与 ticket_service.SKILL_GROUP_TOPICS 保持一致）
KAFKA_TOPIC_DEPT_IT=ticket-dept-it
KAFKA_TOPIC_DEPT_MAINTENANCE=ticket-dept-maintenance
KAFKA_TOPIC_DEPT_FINANCE=ticket-dept-finance
KAFKA_TOPIC_DEPT_SERVICE=ticket-dept-service
# 解决事件 Topic（消费者沉淀向量与知识库）
KAFKA_TOPIC_RESOLVED=ticket-resolved
KAFKA_WORKER_GROUP=ticket-resolution-worker
# Streamlit 进程内是否启动 Kafka 消费者（Docker 下由独立 worker 消费，设为 0）
ENABLE_KAFKA_WORKER=1

# Agent 配置
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=gte-rerank-v2
VECTOR_DIMS=1024
